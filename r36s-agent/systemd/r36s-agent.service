[Unit]
Description=R36S DevBridge Background Agent
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/r36s-agent
Restart=always
RestartSec=3
TimeoutStopSec=10s
KillMode=process
StandardOutput=append:/var/log/r36s-agent.log
StandardError=append:/var/log/r36s-agent.log

[Install]
WantedBy=multi-user.target

